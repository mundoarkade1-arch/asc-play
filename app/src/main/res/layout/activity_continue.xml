<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_pad_h_xl"
    android:paddingTop="@dimen/screen_pad_bottom"
    android:paddingEnd="@dimen/screen_pad_h_xl"
    android:paddingBottom="@dimen/screen_pad_bottom">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Continue assistindo"
        android:textColor="#FF2A3D"
        android:textSize="@dimen/title_text_sm"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_continue_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Carregando..."
        android:textColor="#A99FA3"
        android:textSize="18sp" />

    <ListView
        android:id="@+id/lv_continue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:drawSelectorOnTop="false"
        android:listSelector="@drawable/bg_button" />

</LinearLayout>
