<?xml version="1.0" encoding="utf-8"?>
<!-- Menu à esquerda. Se a tela for baixa demais, o menu rola (nada some).
     Tamanhos em res/values*/dimens.xml. Existe uma CÓPIA em activity_home.xml: mudou um, mude o outro. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_nav"
    android:layout_width="@dimen/nav_w"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nav"
    android:fillViewport="true"
    android:focusable="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/nav_pad_v"
        android:paddingBottom="@dimen/nav_pad_v">

        <TextView
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nav_btn_h"
            android:layout_marginLeft="@dimen/nav_btn_mh"
            android:layout_marginTop="@dimen/nav_btn_mv"
            android:layout_marginRight="@dimen/nav_btn_mh"
            android:layout_marginBottom="@dimen/nav_btn_mv"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:contentDescription="Tela inicial"
            android:drawableTop="@drawable/ic_nav_home"
            android:drawablePadding="2dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/nav_live"
            android:paddingLeft="4dp"
            android:paddingTop="@dimen/nav_btn_pv"
            android:paddingRight="4dp"
            android:paddingBottom="@dimen/nav_btn_pv"
            android:singleLine="true"
            android:text="Tela inicial"
            android:textColor="@color/nav_text"
            android:textSize="@dimen/nav_text" />

        <TextView
            android:id="@+id/nav_live"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nav_btn_h"
            android:layout_marginLeft="@dimen/nav_btn_mh"
            android:layout_marginTop="@dimen/nav_btn_mv"
            android:layout_marginRight="@dimen/nav_btn_mh"
            android:layout_marginBottom="@dimen/nav_btn_mv"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:contentDescription="Canais"
            android:drawableTop="@drawable/ic_nav_live"
            android:drawablePadding="2dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/nav_movie"
            android:nextFocusUp="@+id/nav_home"
            android:paddingLeft="4dp"
            android:paddingTop="@dimen/nav_btn_pv"
            android:paddingRight="4dp"
            android:paddingBottom="@dimen/nav_btn_pv"
            android:singleLine="true"
            android:text="Canais"
            android:textColor="@color/nav_text"
            android:textSize="@dimen/nav_text" />

        <TextView
            android:id="@+id/nav_movie"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nav_btn_h"
            android:layout_marginLeft="@dimen/nav_btn_mh"
            android:layout_marginTop="@dimen/nav_btn_mv"
            android:layout_marginRight="@dimen/nav_btn_mh"
            android:layout_marginBottom="@dimen/nav_btn_mv"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:contentDescription="Filmes"
            android:drawableTop="@drawable/ic_nav_movie"
            android:drawablePadding="2dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/nav_series"
            android:nextFocusUp="@+id/nav_live"
            android:paddingLeft="4dp"
            android:paddingTop="@dimen/nav_btn_pv"
            android:paddingRight="4dp"
            android:paddingBottom="@dimen/nav_btn_pv"
            android:singleLine="true"
            android:text="Filmes"
            android:textColor="@color/nav_text"
            android:textSize="@dimen/nav_text" />

        <TextView
            android:id="@+id/nav_series"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nav_btn_h"
            android:layout_marginLeft="@dimen/nav_btn_mh"
            android:layout_marginTop="@dimen/nav_btn_mv"
            android:layout_marginRight="@dimen/nav_btn_mh"
            android:layout_marginBottom="@dimen/nav_btn_mv"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:contentDescription="Séries"
            android:drawableTop="@drawable/ic_nav_series"
            android:drawablePadding="2dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/nav_settings"
            android:nextFocusUp="@+id/nav_movie"
            android:paddingLeft="4dp"
            android:paddingTop="@dimen/nav_btn_pv"
            android:paddingRight="4dp"
            android:paddingBottom="@dimen/nav_btn_pv"
            android:singleLine="true"
            android:text="Séries"
            android:textColor="@color/nav_text"
            android:textSize="@dimen/nav_text" />

        <TextView
            android:id="@+id/nav_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nav_btn_h"
            android:layout_marginLeft="@dimen/nav_btn_mh"
            android:layout_marginTop="@dimen/nav_btn_mv"
            android:layout_marginRight="@dimen/nav_btn_mh"
            android:layout_marginBottom="@dimen/nav_btn_mv"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:contentDescription="Ajustes"
            android:drawableTop="@drawable/ic_nav_settings"
            android:drawablePadding="2dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/nav_refresh"
            android:nextFocusUp="@+id/nav_series"
            android:paddingLeft="4dp"
            android:paddingTop="@dimen/nav_btn_pv"
            android:paddingRight="4dp"
            android:paddingBottom="@dimen/nav_btn_pv"
            android:singleLine="true"
            android:text="Ajustes"
            android:textColor="@color/nav_text"
            android:textSize="@dimen/nav_text" />

        <TextView
            android:id="@+id/nav_refresh"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nav_btn_h"
            android:layout_marginLeft="@dimen/nav_btn_mh"
            android:layout_marginTop="@dimen/nav_btn_mv"
            android:layout_marginRight="@dimen/nav_btn_mh"
            android:layout_marginBottom="@dimen/nav_btn_mv"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:contentDescription="Atualizar lista"
            android:drawableTop="@drawable/ic_nav_refresh"
            android:drawablePadding="2dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusUp="@+id/nav_settings"
            android:paddingLeft="4dp"
            android:paddingTop="@dimen/nav_btn_pv"
            android:paddingRight="4dp"
            android:paddingBottom="@dimen/nav_btn_pv"
            android:singleLine="true"
            android:text="Atualizar"
            android:textColor="@color/nav_text"
            android:textSize="@dimen/nav_text" />
    </LinearLayout>
</ScrollView>
