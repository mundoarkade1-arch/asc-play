<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_pad_h_lg"
    android:paddingTop="@dimen/movie_pad_v"
    android:paddingEnd="@dimen/screen_pad_h_lg"
    android:paddingBottom="@dimen/movie_pad_v">

    <ImageView
        android:id="@+id/iv_cover"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:background="@drawable/bg_poster"
        android:contentDescription="Capa"
        android:maxWidth="@dimen/movie_cover_max_w"
        android:minWidth="120dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/movie_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FF2A3D"
            android:textSize="@dimen/title_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#A99FA3"
            android:textSize="@dimen/movie_body_text"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_continue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/btn_mt"
            android:background="@drawable/bg_button"
            android:focusable="true"
            android:minHeight="@dimen/btn_min_h"
            android:minWidth="200dp"
            android:paddingStart="@dimen/btn_pad_h"
            android:paddingEnd="@dimen/btn_pad_h"
            android:text="Continuar de onde parei"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/movie_btn_text"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/btn_mt"
            android:background="@drawable/bg_button"
            android:focusable="true"
            android:minHeight="@dimen/btn_min_h"
            android:minWidth="200dp"
            android:paddingStart="@dimen/btn_pad_h"
            android:paddingEnd="@dimen/btn_pad_h"
            android:text="Tocar"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/movie_btn_text"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/sv_plot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/btn_mt"
            android:minHeight="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:focusable="true"
            android:padding="12dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tv_plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="Carregando..."
                android:textColor="#E6DFE1"
                android:textSize="@dimen/movie_body_text" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
